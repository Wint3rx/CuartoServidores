# Copia este archivo como ".env" y cambia los valores.
# Lo leen tanto Docker Compose (la base de datos) como el backend.

PORT=3000

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=cuarto_servidores
DB_USER=cuarto_user
DB_PASSWORD=cambia-esta-clave
DB_ROOT_PASSWORD=cambia-esta-clave-root

# --- Autenticacion del panel ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Solo para "npm run seed" ---
ADMIN_EMAIL=admin@cuarto.local
ADMIN_PASSWORD=cambia-esta-clave-admin
